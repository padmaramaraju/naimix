# Port the middleware server listens on
PORT=4000

# Folder containing BOTH an endpoints/ subfolder and a gateways.yaml file --
# e.g. your local checkout of a team Git repo of endpoints+gateways. See
# "Workspace" in the README. Leave unset to use ENDPOINTS_DIR/GATEWAYS_FILE
# below instead. Once a workspace has been chosen through the admin UI's
# "Change workspace..." control, that takes priority over this on every
# future start (see SETTINGS_FILE below).
#CONFIG_DIR=

# Directory containing endpoint config files (YAML or JSON), relative to
# project root. Ignored once CONFIG_DIR or a UI-chosen workspace is in effect.
ENDPOINTS_DIR=config/endpoints

# Path to the gateways config file (backend gateway details / secrets).
# Ignored once CONFIG_DIR or a UI-chosen workspace is in effect.
GATEWAYS_FILE=config/gateways.yaml

# Where the admin UI's "Change workspace..." choice is remembered, so it
# survives a restart. A per-machine preference file -- don't check it into
# Git. Default shown below.
#SETTINGS_FILE=data/settings.json

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Required to enable the admin UI/API (http://localhost:4000/admin). Any
# request to /admin/api/* must send this as "Authorization: Bearer <token>".
# Leave unset to disable the admin UI/API entirely. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# Max request body size (JSON/urlencoded), e.g. "10mb", "500kb", "1gb" -- see
# https://www.npmjs.com/package/bytes for accepted formats. Raise this if a
# real endpoint's payload (a large XML/SOAP body, a bulk SQL write with many
# rows, a sizable admin UI save) trips "request entity too large". Default
# shown below.
#MAX_REQUEST_BODY_SIZE=10mb

# --- Example secrets referenced by config/gateways.yaml via ${env.NAME} ---
DEMO_JSON_BASE_URL=http://localhost:5000
DEMO_XML_BASE_URL=http://localhost:5000
DEMO_SOAP_WSDL_URL=http://localhost:5000/soap?wsdl
DEMO_SQLITE_PATH=./data/demo.sqlite

# --- Example secret referenced by config/authProviders.yaml (demoOAuth) ---
# See AUTH_DESIGN_NOTES.md. Log in via POST /auth/login/demoOAuth or
# /auth/login/demoLogin with { "username": "demo", "password": "demo123" }.
DEMO_OAUTH_CLIENT_SECRET=demo-secret

# --- Example secrets referenced by config/authProviders.yaml (demoLdap) ---
# See docker/openldap/README.md to run a free local LDAP test directory, then
# point this at it (its docker-compose.yml maps the container to localhost:3389).
# Log in via POST /auth/login/demoLdap with jdoe/asmith/bwayne, password
# "password123".
DEMO_LDAP_URL=ldap://localhost:3389
DEMO_LDAP_BIND_PASSWORD=adminpw123
# Signs the stand-in backend JWT this provider mints on a successful bind
# (LDAP/AD has no native token to relay) -- any real value works for local
# testing; never reuse it anywhere real.
DEMO_LDAP_TOKEN_SECRET=demo-ldap-token-secret
