{
  "name": "naimix",
  "version": "1.0.0",
  "description": "Configurable middleware server that connects to SOAP, XML, JSON and Database backends, transforms the response per user-defined config, and serves JSON.",
  "main": "dist/server/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/mock-backend/customerService.wsdl dist/mock-backend/customerService.wsdl",
    "start": "node dist/server/index.js",
    "dev": "tsx watch src/server/index.ts",
    "mock-backend": "tsx watch src/mock-backend/index.ts",
    "test-ldap": "docker compose -f docker/openldap/docker-compose.yml up",
    "test-ldap:down": "docker compose -f docker/openldap/docker-compose.yml down -v",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.11.0",
    "js-yaml": "^4.1.0",
    "jsonpath-plus": "^10.2.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "ldapts": "^9.2.0",
    "mssql": "^11.0.1",
    "mysql2": "^3.12.0",
    "path-to-regexp": "^8.4.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "soap": "^1.10.0",
    "sqlite3": "^6.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ldapjs": "^3.0.6",
    "@types/node": "^22.10.7",
    "@types/supertest": "^7.2.1",
    "ldapjs": "^3.0.7",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
